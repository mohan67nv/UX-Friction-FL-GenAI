# Copy to .env and adjust

# --- API ---
# Namespace these vars to avoid collisions with other projects
PRIVACYEDGE_DATABASE_URL=postgresql://privacyedge:privacyedge@localhost:5432/privacyedge
PRIVACYEDGE_REDIS_URL=redis://localhost:6379/0
PRIVACYEDGE_API_KEY_SALT=change-me
PRIVACYEDGE_CORS_ORIGINS=http://localhost:3000

# --- GenAI (optional) ---
# Embeddings: default is lightweight "hash". To enable real semantic embeddings:
# EMBEDDINGS_BACKEND=st
#
# On-device intent embedder model served by API:
# INTENT_EMBEDDER_ONNX_PATH=ml-training/intent_embedder.onnx
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=friction_insights
#
# LLM backends:
# LLM_BACKEND=auto|deepseek|openai|ollama
# LLM_TIMEOUT_SECONDS=25
#
# DeepSeek (OpenAI-compatible):
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.2
#
# OpenAI (optional):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2
#
# Ollama (optional local):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b-instruct
# OLLAMA_TEMPERATURE=0.2
#
# Orchestration:
# GENAI_ORCHESTRATOR=native|haystack|langchain|rag

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-key-change-me
