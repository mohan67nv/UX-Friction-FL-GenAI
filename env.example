# Copy to .env and adjust

# --- API ---
DATABASE_URL=postgresql://privacyedge:privacyedge@localhost:5432/privacyedge
REDIS_URL=redis://localhost:6379/0
API_KEY_SALT=change-me
CORS_ORIGINS=http://localhost:3000

# --- GenAI (optional) ---
# Embeddings: default is lightweight "hash". To enable real semantic embeddings:
# EMBEDDINGS_BACKEND=st
#
# On-device intent embedder model served by API:
# INTENT_EMBEDDER_ONNX_PATH=ml-training/intent_embedder.onnx
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=friction_insights
#
# LLM backends:
# LLM_BACKEND=auto|openai|ollama
#
# Orchestration:
# GENAI_ORCHESTRATOR=native|haystack
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b-instruct

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-key-change-me
